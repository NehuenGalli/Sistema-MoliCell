PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/moli_cell_db
DATABASE_URL_TEST=postgresql://usuario:password@localhost:5432/moli_cell_test
NODE_ENV=development
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Orígenes web autorizados, separados por coma
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://molicell.store

# JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000
# Usar "none" únicamente si frontend y API están en sitios diferentes (requiere HTTPS)
AUTH_COOKIE_SAME_SITE=lax
# Compatibilidad temporal con clientes Bearer; mantener false en producción
EXPOSE_AUTH_TOKEN=false

# Admin para seed (se usa solo con: npm run seed-admin)
ADMIN_EMAIL=admin@molicell.com
ADMIN_PASSWORD=TuPasswordSeguro123!

# Credenciales de Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
