{
  "name": "molicell-thermal-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agente local para imprimir tickets ESC/POS en impresoras térmicas Windows.",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build:windows": "pkg agent.js --targets node22-win-x64 --output MoliCellThermalPrintAgent.exe",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=65 --test-coverage-branches=65 --test-coverage-functions=80"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
